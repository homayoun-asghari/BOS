## Supabase (required)
# Your Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key (Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Supabase (optional)
# Only needed for admin scripts / server-side admin operations. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

## Logging (optional)
# Set to "true" to enable verbose client-side logs
NEXT_PUBLIC_ENABLE_LOGS=false

